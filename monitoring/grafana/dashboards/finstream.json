{
  "title": "finstream Pipeline",
  "uid": "finstream-pipeline",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Pipeline Runs (total)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short" } },
      "targets": [{ "expr": "sum(finstream_pipeline_runs_total)", "legendFormat": "Runs", "datasource": "Prometheus" }]
    },
    {
      "id": 2, "type": "stat", "title": "Quality Score (last run)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 80 },
            { "color": "green", "value": 95 }
          ]}
        }
      },
      "targets": [{ "expr": "finstream_quality_score", "legendFormat": "Score", "datasource": "Prometheus" }]
    },
    {
      "id": 3, "type": "stat", "title": "Records Processed (total)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" } },
      "targets": [{ "expr": "finstream_records_processed_total", "legendFormat": "Records", "datasource": "Prometheus" }]
    },
    {
      "id": 4, "type": "stat", "title": "Runs complétés",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" } },
      "targets": [{ "expr": "finstream_pipeline_runs_total{status=\"COMPLETED\"}", "legendFormat": "Completed", "datasource": "Prometheus" }]
    },
    {
      "id": 5, "type": "stat", "title": "Runs échoués",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" } },
      "targets": [{ "expr": "finstream_pipeline_runs_total{status=\"FAILED\"} or vector(0)", "legendFormat": "Failed", "datasource": "Prometheus" }]
    },
    {
      "id": 6, "type": "stat", "title": "Runs / min",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "short", "decimals": 2 } },
      "targets": [{ "expr": "rate(finstream_pipeline_runs_total[1m]) * 60", "legendFormat": "runs/min", "datasource": "Prometheus" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Runs pipeline dans le temps",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "targets": [
        { "expr": "increase(finstream_pipeline_runs_total{status=\"COMPLETED\"}[1m])", "legendFormat": "Complétés", "datasource": "Prometheus" },
        { "expr": "increase(finstream_pipeline_runs_total{status=\"FAILED\"}[1m])", "legendFormat": "Échoués", "datasource": "Prometheus" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Quality Score dans le temps",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 80 },
            { "color": "green", "value": 95 }
          ]}
        }
      },
      "targets": [{ "expr": "finstream_quality_score", "legendFormat": "Quality %", "datasource": "Prometheus" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Records traités dans le temps",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "increase(finstream_records_processed_total[1m])", "legendFormat": "Records / min", "datasource": "Prometheus" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Durée traitement chunk (p95)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(finstream_chunk_processing_seconds_bucket[5m]))",
        "legendFormat": "p95 duration",
        "datasource": "Prometheus"
      }]
    }
  ]
}
